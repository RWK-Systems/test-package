<Window x:Class="TestPackageInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestPackage Setup" Height="520" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0" x:Name="HeaderBanner" Background="#0078D4">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="TestPackage Setup"
                               FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="Installation Wizard"
                               FontSize="11" Foreground="#CCE5FF"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="RWK Systems"
                           VerticalAlignment="Center" Foreground="#99CCFF" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Page Content Area -->
        <Border Grid.Row="1" Margin="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1">
            <Grid x:Name="PageContainer" Margin="30,20">
                <!-- Pages are swapped in/out here programmatically -->

                <!-- Welcome Page -->
                <StackPanel x:Name="WelcomePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Welcome to TestPackage Setup"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        This wizard will guide you through the installation of TestPackage.
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageDescription}">
                        TestPackage is a configurable installation simulator created by RWK Systems
                        for testing software repackaging, application virtualization, and deployment solutions.
                    </TextBlock>
                    <TextBlock Style="{StaticResource PageDescription}" Margin="0,10,0,0">
                        Unlike using generic applications (like 7-Zip or Notepad++) for testing, TestPackage
                        provides purpose-built, configurable scenarios that exercise specific installer behaviors
                        including registry writes, file associations, services, shortcuts, and more.
                    </TextBlock>
                    <TextBlock Margin="0,15,0,0" FontSize="12" Foreground="#888">
                        Click Next to continue, or Cancel to exit Setup.
                    </TextBlock>
                </StackPanel>

                <!-- EULA Page -->
                <StackPanel x:Name="EULAPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="License Agreement"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Please read the following license agreement carefully.
                    </TextBlock>
                    <TextBox x:Name="EULAText" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="200"
                             Margin="0,0,0,10" Padding="10" FontSize="12"
                             Background="#FAFAFA" BorderBrush="#DDD"/>
                    <CheckBox x:Name="AcceptEULA" Content="I accept the terms of the License Agreement"
                              FontSize="13" Margin="0,5"/>
                </StackPanel>

                <!-- Install Context Page -->
                <StackPanel x:Name="ContextPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Installation Context"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Choose whether to install for all users (machine-wide) or only for the current user.
                    </TextBlock>
                    <RadioButton x:Name="ContextMachine" Content="Install for all users (Machine)"
                                 FontSize="13" Margin="0,10" IsChecked="True" GroupName="Context"/>
                    <TextBlock Text="Requires administrator privileges. Installs to Program Files."
                               Margin="20,0,0,15" FontSize="11" Foreground="#888"/>
                    <RadioButton x:Name="ContextUser" Content="Install for current user only"
                                 FontSize="13" Margin="0,5" GroupName="Context"/>
                    <TextBlock Text="No admin required. Installs to Local AppData."
                               Margin="20,0,0,10" FontSize="11" Foreground="#888"/>
                </StackPanel>

                <!-- Target Directory Page -->
                <StackPanel x:Name="DirectoryPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Installation Directory"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Choose the folder where TestPackage will be installed.
                    </TextBlock>
                    <TextBlock Text="Destination folder:" FontSize="13" Margin="0,5,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPath" FontSize="13" Padding="5,5"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                                Padding="12,5" Click="BrowseFolder_Click"/>
                    </Grid>
                    <TextBlock x:Name="SpaceRequired" Text="Space required: ~5 MB"
                               Margin="0,15,0,0" FontSize="11" Foreground="#888"/>
                </StackPanel>

                <!-- Components Page -->
                <StackPanel x:Name="ComponentsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Select Components"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Select the components you want to install. Each component creates test files
                        that can be verified during repackaging validation.
                    </TextBlock>
                    <StackPanel x:Name="ComponentsList" Margin="0,5"/>
                </StackPanel>

                <!-- Options Page -->
                <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Additional Options"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Configure additional installation options.
                    </TextBlock>
                    <CheckBox x:Name="OptDesktopShortcut" Content="Create a desktop shortcut"
                              FontSize="13" Margin="0,8" IsChecked="True"/>
                    <CheckBox x:Name="OptStartMenuPin" Content="Pin to Start Menu"
                              FontSize="13" Margin="0,8"/>
                    <CheckBox x:Name="OptActiveSetup" Content="Register Active Setup component (per-user on next login)"
                              FontSize="13" Margin="0,8"/>
                    <CheckBox x:Name="OptReboot" Content="Prompt for reboot after installation"
                              FontSize="13" Margin="0,8"/>
                </StackPanel>

                <!-- Installing Page -->
                <StackPanel x:Name="InstallingPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Installing..."/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        Please wait while TestPackage is being installed.
                    </TextBlock>
                    <ProgressBar x:Name="InstallProgress" Height="22" Margin="0,10,0,15"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="#0078D4"/>
                    <TextBlock x:Name="InstallStatus" Text="Preparing..." FontSize="12" Foreground="#555"/>
                    <ScrollViewer x:Name="LogScroller" Height="150" Margin="0,15,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="InstallLog" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" FontSize="11" Background="#1E1E1E"
                                 Foreground="#CCCCCC" Padding="8" BorderThickness="0"/>
                    </ScrollViewer>
                </StackPanel>

                <!-- Complete Page -->
                <StackPanel x:Name="CompletePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Installation Complete"/>
                    <TextBlock Style="{StaticResource PageDescription}">
                        TestPackage has been successfully installed.
                    </TextBlock>
                    <Border Background="#E8F5E9" CornerRadius="5" Padding="15" Margin="0,5,0,15">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32">
                                Installation Summary
                            </TextBlock>
                            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#333"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <CheckBox x:Name="LaunchApp" Content="Launch TestPackage application"
                              FontSize="13" IsChecked="True" Margin="0,5"/>
                    <TextBlock Margin="0,20,0,0" FontSize="11" Foreground="#888">
                        <Run Text="TestPackage by "/><Hyperlink x:Name="CreditLink"
                        NavigateUri="https://rwksystems.com" RequestNavigate="Hyperlink_Navigate">
                        RWK Systems</Hyperlink>
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Footer with navigation buttons -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource WizardButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="&lt; Back" Style="{StaticResource WizardButton}"
                            Click="Back_Click"/>
                    <Button x:Name="BtnNext" Content="Next &gt;" Style="{StaticResource PrimaryButton}"
                            Click="Next_Click"/>
                    <Button x:Name="BtnInstall" Content="Install" Style="{StaticResource PrimaryButton}"
                            Click="Install_Click" Visibility="Collapsed"/>
                    <Button x:Name="BtnFinish" Content="Finish" Style="{StaticResource PrimaryButton}"
                            Click="Finish_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
