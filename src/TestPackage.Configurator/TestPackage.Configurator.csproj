<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>TestPackageConfigurator</AssemblyName>
    <RootNamespace>TestPackage.Configurator</RootNamespace>
    <Version>3.0.0-alpha.2</Version>
    <Company>RWK Systems</Company>
    <Product>TestPackage</Product>
    <Description>A configurable installation simulator for testing repackaging and deployment solutions</Description>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestPackage.Core\TestPackage.Core.csproj" />
  </ItemGroup>

  <!-- Presets are shipped as embedded resources; loaded by name at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Presets\*.ini">
      <LogicalName>TestPackage.Configurator.Presets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
