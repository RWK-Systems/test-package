<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>TestPackageConfigurator</AssemblyName>
    <RootNamespace>TestPackage.Configurator</RootNamespace>
    <Version>2.0.0</Version>
    <Company>RWK Systems</Company>
    <Product>TestPackage Configurator</Product>
    <Description>Configure and generate simulated installers for testing repackaging and deployment solutions</Description>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestPackage.Core\TestPackage.Core.csproj" />
  </ItemGroup>

</Project>
