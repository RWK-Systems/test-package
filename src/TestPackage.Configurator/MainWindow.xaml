<Window x:Class="TestPackage.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestPackage" Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="13"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Preset strip -->
            <RowDefinition Height="Auto"/>  <!-- Persona strip -->
            <RowDefinition Height="Auto"/>  <!-- Frame nav tiles -->
            <RowDefinition Height="*"/>     <!-- Frames + Receipt -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BrandMark}" Text="TESTPACKAGE"/>
                    <TextBlock Style="{StaticResource BrandKicker}" Text="INSTALLER GENERATOR · V3.0" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Load config"  Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="LoadConfig_Click"/>
                    <Button Content="Save config"  Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="SaveConfig_Click"/>
                    <Button Content="Preview wizard" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Preview_Click"/>
                    <Button Content="Generate installer" Style="{StaticResource PrimaryButton}" Click="GenerateInstaller_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Preset strip ================= -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" Margin="24,10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BrandKicker}" Text="START FROM" Margin="0,0,12,0"/>
                <Button Content="Blank"                Style="{StaticResource ChipButton}" Tag="blank"                Click="ApplyPreset_Click"/>
                <Button Content="Typical desktop app"  Style="{StaticResource ChipButton}" Tag="typical-desktop-app"  Click="ApplyPreset_Click"/>
                <Button Content="Service + firewall"   Style="{StaticResource ChipButton}" Tag="service-firewall"     Click="ApplyPreset_Click"/>
                <Button Content="Enterprise"           Style="{StaticResource ChipButton}" Tag="enterprise"           Click="ApplyPreset_Click"/>
                <TextBlock Style="{StaticResource MutedText}" Text="Presets replace install actions and their sample data; identity, wizard and uninstall are untouched." Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= Persona strip ================= -->
        <!-- The installer is a real installer — a test one, whose payload does
             nothing of consequence. The user configures the installer's
             behaviors + registered identity, not "an app." -->
        <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource BrandKicker}" Text="YOU ARE BUILDING AN INSTALLER" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Everything below configures the installer TestPackage will produce — not TestPackage itself. Generate builds "/>
                    <Run x:Name="RunInstallerExeName" FontFamily="{StaticResource MonoFont}" Text="YourSimulatedSetup.exe"/>
                    <Run Text=". Running that installer registers "/>
                    <Run x:Name="RunPersonaAppName" FontWeight="Bold" Text="My Test Package"/>
                    <Run Text=" in Add/Remove Programs, performs the install actions below, and drops an audit viewer that reports everything it did."/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ================= Frame navigation tiles ================= -->
        <!-- Six section tiles across the top of the workspace; clicking one
             scrolls the left column to that frame's card. The currently-
             visible frame's tile is highlighted based on scroll position. -->
        <Border Grid.Row="3" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="24,10">
                <StackPanel x:Name="FrameTilesPanel" Orientation="Horizontal">
                    <Button Style="{StaticResource FrameTile}" Tag="Identity"       Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="01"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Identity"/>
                            <TextBlock x:Name="LblTileIdentity" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FrameTile}" Tag="Wizard"         Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="02"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Wizard"/>
                            <TextBlock x:Name="LblTileWizard" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FrameTile}" Tag="InstallActions" Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="03"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Install actions"/>
                            <TextBlock x:Name="LblTileInstallActions" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FrameTile}" Tag="Uninstall"      Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="04"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Uninstall"/>
                            <TextBlock x:Name="LblTileUninstall" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FrameTile}" Tag="Appearance"     Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="05"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Appearance"/>
                            <TextBlock x:Name="LblTileAppearance" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FrameTile}" Tag="Package"        Click="FrameTile_Click">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameTileEyebrow}" Text="06"/>
                            <TextBlock Style="{StaticResource FrameTileTitle}" Text="Package"/>
                            <TextBlock x:Name="LblTilePackage" Style="{StaticResource FrameTileMeta}" Text="—"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Frames + Receipt ================= -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <!-- Frames column -->
            <ScrollViewer x:Name="FramesScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,20,16,20"
                          ScrollChanged="FramesScroll_ScrollChanged">
                <StackPanel x:Name="FramesStack">

                    <!-- ===== Frame 01 — Identity ===== -->
                    <Border x:Name="FrameIdentity" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 01 · IDENTITY"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Identity"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="How the installer registers itself in Windows — the display name shown in Add/Remove Programs and the wizard, the publisher, and where it installs."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="DISPLAY NAME"/>
                            <TextBox x:Name="TxtAppName" Style="{StaticResource FieldTextBox}" TextChanged="DefaultPathSource_TextChanged"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="VERSION"/>
                                    <TextBox x:Name="TxtAppVersion" Style="{StaticResource MonoTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PUBLISHER"/>
                                    <TextBox x:Name="TxtAppPublisher" Style="{StaticResource FieldTextBox}" TextChanged="DefaultPathSource_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="URL"/>
                            <TextBox x:Name="TxtAppURL" Style="{StaticResource FieldTextBox}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="PRODUCT GUID"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtAppGUID" Style="{StaticResource MonoTextBox}"/>
                                <Button Grid.Column="1" Content="New GUID" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GenerateGUID_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="INSTALL CONTEXT"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="CboDefaultContext" Style="{StaticResource ModernComboBox}" Width="220" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Machine"/>
                                    <ComboBoxItem Content="User"/>
                                </ComboBox>
                                <CheckBox x:Name="ChkRequireAdmin" Style="{StaticResource FeatureToggle}" Content="Require Administrator (UAC)" Margin="24,0,0,0"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="DEFAULT INSTALL DIRECTORY"/>
                            <TextBox x:Name="TxtDefaultPath" Style="{StaticResource MonoTextBox}" TextChanged="DefaultPath_TextChanged"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Derived from Publisher\App Name. Type to override; clear to re-derive." Margin="0,2,0,0"/>
                            <CheckBox x:Name="ChkAllowCustomPath" Style="{StaticResource FeatureToggle}" Content="Allow user to customise path in the wizard" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Frame 02 — Wizard ===== -->
                    <Border x:Name="FrameWizard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 02 · WIZARD"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Wizard experience"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="Which pages the installer shows, what they default to, and the licence copy."/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="PAGE ORDER"/>
                            <CheckBox x:Name="ChkShowWelcome"         Style="{StaticResource FeatureToggle}" Content="Welcome"/>
                            <CheckBox x:Name="ChkShowEULA"            Style="{StaticResource FeatureToggle}" Content="Licence agreement"/>
                            <CheckBox x:Name="ChkShowInstallContext"  Style="{StaticResource FeatureToggle}" Content="Install context (Machine/User)"/>
                            <CheckBox x:Name="ChkShowTargetDirectory" Style="{StaticResource FeatureToggle}" Content="Target directory"/>
                            <CheckBox x:Name="ChkShowComponents"      Style="{StaticResource FeatureToggle}" Content="Component selection"/>
                            <CheckBox x:Name="ChkShowDesktopShortcut" Style="{StaticResource FeatureToggle}" Content="Desktop shortcut option"/>
                            <CheckBox x:Name="ChkShowStartMenuPin"    Style="{StaticResource FeatureToggle}" Content="Start Menu pin option"/>
                            <CheckBox x:Name="ChkShowRebootOption"    Style="{StaticResource FeatureToggle}" Content="Reboot option"/>
                            <CheckBox x:Name="ChkShowActiveSetup"     Style="{StaticResource FeatureToggle}" Content="Active Setup option"/>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="PRE-CHECKED DEFAULTS"/>
                            <CheckBox x:Name="ChkDefaultDesktopShortcut" Style="{StaticResource FeatureToggle}" Content="Desktop shortcut on"/>
                            <CheckBox x:Name="ChkDefaultStartMenuPin"    Style="{StaticResource FeatureToggle}" Content="Start Menu pin on"/>
                            <CheckBox x:Name="ChkDefaultActiveSetup"     Style="{StaticResource FeatureToggle}" Content="Active Setup on"/>
                            <CheckBox x:Name="ChkDefaultReboot"          Style="{StaticResource FeatureToggle}" Content="Reboot prompt on"/>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="EULA TEXT"/>
                            <TextBox x:Name="TxtEULAText" Style="{StaticResource FieldTextBox}" TextWrapping="Wrap" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Frame 03 — Install actions ===== -->
                    <Border x:Name="FrameInstallActions" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 03 · INSTALL ACTIONS"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Install actions"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="What the installer does to Windows when it runs. Turn a behavior on, then use Edit data to add or edit its entries."/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="INSTALLER SIZE"/>
                            <CheckBox x:Name="ChkInstallerSize" Style="{StaticResource FeatureToggle}" Content="Pad the generated setup .exe to a target size"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Slider: fine MB control on the left, GB on the right. Up to 100 GB. Install-time disk-space check runs against the requested size." TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Slider x:Name="SldInstallerSize" Minimum="0" Maximum="100" Width="420" HorizontalAlignment="Left" Margin="0,4,0,4" ValueChanged="InstallerSizeSlider_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="EXACT (MB)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtInstallerSizeMB" Style="{StaticResource MonoTextBox}" Width="120" Text="0" TextChanged="InstallerSizeMB_Changed"/>
                                <TextBlock x:Name="LblInstallerSizeReadout" Style="{StaticResource MonoText}" Foreground="{StaticResource InkFaintBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="COMPONENTS"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Optional features the wizard offers on the Component Selection page."/>
                            <StackPanel x:Name="ComponentsList" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBox x:Name="TxtNewComponent" Style="{StaticResource FieldTextBox}" Width="220" Margin="0,0,8,0"/>
                                <Button Content="+ Add component" Style="{StaticResource SecondaryButton}" Click="AddComponent_Click"/>
                            </StackPanel>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkTestFilesEnabled" Style="{StaticResource FeatureToggle}" Content="Test files"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Marker files the installer writes to verify file-system capture."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblTestFilesSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="TestFiles" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkRegistryEnabled" Style="{StaticResource FeatureToggle}" Content="Registry entries"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="HKCU / HKLM values written during install."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblRegistrySummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="RegistryEntries" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="SHORTCUTS"/>
                            <CheckBox x:Name="ChkDesktopShortcut" Style="{StaticResource FeatureToggle}" Content="Create desktop shortcut"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SHORTCUT NAME"/>
                            <TextBox x:Name="TxtDesktopShortcutName" Style="{StaticResource FieldTextBox}"/>
                            <CheckBox x:Name="ChkStartMenuEntry" Style="{StaticResource FeatureToggle}" Content="Create Start Menu entry" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="START MENU FOLDER"/>
                            <TextBox x:Name="TxtStartMenuFolder" Style="{StaticResource MonoTextBox}" TextChanged="StartMenuFolder_TextChanged"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Derived from Publisher\App Name. Type to override; clear to re-derive." Margin="0,2,0,0"/>
                            <CheckBox x:Name="ChkPinToStartMenu" Style="{StaticResource FeatureToggle}" Content="Pin to Start Menu" Margin="0,8,0,0"/>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkFileAssociations" Style="{StaticResource FeatureToggle}" Content="File associations"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Extensions the installer registers as owned by this app."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFileAssociationsSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="FileAssociations" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkContextMenu" Style="{StaticResource FeatureToggle}" Content="Shell context menu entries"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Right-click actions the installer registers under file types or folders."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblContextMenuSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="ContextMenuEntries" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkEnvVars" Style="{StaticResource FeatureToggle}" Content="Environment variables"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="User or System environment variables the installer sets."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblEnvVarsSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="EnvironmentVariables" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkService" Style="{StaticResource FeatureToggle}" Content="Windows service"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SERVICE NAME"/>
                            <TextBox x:Name="TxtServiceName" Style="{StaticResource FieldTextBox}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DISPLAY NAME"/>
                            <TextBox x:Name="TxtServiceDisplayName" Style="{StaticResource FieldTextBox}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="START TYPE"/>
                            <ComboBox x:Name="CboServiceStartType" Style="{StaticResource ModernComboBox}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Automatic"/>
                                <ComboBoxItem Content="Manual" IsSelected="True"/>
                                <ComboBoxItem Content="Disabled"/>
                            </ComboBox>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkScheduledTask" Style="{StaticResource FeatureToggle}" Content="Scheduled task"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TASK NAME"/>
                            <TextBox x:Name="TxtTaskName" Style="{StaticResource FieldTextBox}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SCHEDULE"/>
                            <ComboBox x:Name="CboTaskSchedule" Style="{StaticResource ModernComboBox}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Daily" IsSelected="True"/>
                                <ComboBoxItem Content="Weekly"/>
                                <ComboBoxItem Content="AtLogon"/>
                                <ComboBoxItem Content="AtStartup"/>
                            </ComboBox>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkFirewall" Style="{StaticResource FeatureToggle}" Content="Firewall rules"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Windows Firewall rules the installer adds."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFirewallSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="FirewallRules" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <CheckBox x:Name="ChkProtocolHandlers" Style="{StaticResource FeatureToggle}" Content="URI protocol handlers"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Custom URI schemes (e.g. myapp://) the installer registers."/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblProtocolHandlersSummary" Grid.Column="0" Style="{StaticResource MonoText}" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Edit data →" Style="{StaticResource SecondaryButton}" Tag="ProtocolHandlers" Click="OpenComposite_Click"/>
                            </Grid>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="OTHER"/>
                            <CheckBox x:Name="ChkActiveSetup" Style="{StaticResource FeatureToggle}" Content="Register Active Setup component"/>
                            <CheckBox x:Name="ChkAppPaths"    Style="{StaticResource FeatureToggle}" Content="Register in App Paths (Run dialog)"/>
                            <CheckBox x:Name="ChkStartup"     Style="{StaticResource FeatureToggle}" Content="Add to Windows startup"/>
                            <ComboBox x:Name="CboStartupMethod" Style="{StaticResource ModernComboBox}" Width="220" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <ComboBoxItem Content="Registry" IsSelected="True"/>
                                <ComboBoxItem Content="StartupFolder"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- ===== Frame 04 — Uninstall ===== -->
                    <Border x:Name="FrameUninstall" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 04 · UNINSTALL"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Uninstall &amp; reboot"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="How cleanly the installer removes what it wrote — including things left behind on purpose, for testing orphan detection."/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="UNINSTALL BEHAVIOR"/>
                            <CheckBox x:Name="ChkRegisterUninstaller" Style="{StaticResource FeatureToggle}" Content="Register in Add/Remove Programs"/>
                            <CheckBox x:Name="ChkCleanFiles"          Style="{StaticResource FeatureToggle}" Content="Clean files on uninstall"/>
                            <CheckBox x:Name="ChkCleanRegistry"       Style="{StaticResource FeatureToggle}" Content="Clean registry on uninstall"/>
                            <CheckBox x:Name="ChkCleanShortcuts"      Style="{StaticResource FeatureToggle}" Content="Clean shortcuts on uninstall"/>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="INTENTIONAL LEFTOVERS"/>
                            <CheckBox x:Name="ChkLeaveFiles" Style="{StaticResource FeatureToggle}" Content="Leave files behind after uninstall"/>
                            <TextBox x:Name="TxtLeftoverFiles" Style="{StaticResource MonoTextBox}" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkLeaveRegistry" Style="{StaticResource FeatureToggle}" Content="Leave registry entries behind after uninstall" Margin="0,8,0,0"/>
                            <TextBox x:Name="TxtLeftoverRegistry" Style="{StaticResource MonoTextBox}" TextWrapping="Wrap"/>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="REBOOT"/>
                            <CheckBox x:Name="ChkPromptReboot" Style="{StaticResource FeatureToggle}" Content="Prompt for reboot after installation"/>
                            <CheckBox x:Name="ChkForceReboot"  Style="{StaticResource FeatureToggle}" Content="Force reboot (use with caution!)"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Frame 05 — Wizard appearance ===== -->
                    <Border x:Name="FrameAppearance" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 05 · WIZARD APPEARANCE"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Wizard appearance"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="Cosmetics of the installer's wizard — banner, accent and pacing."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="BANNER COLOR"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BannerColorPreview" Width="28" Height="28" Background="#0078D4"
                                        BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Margin="0,0,8,0"
                                        Cursor="Hand" MouseLeftButtonUp="BannerColorPicker_Click"/>
                                <TextBox x:Name="TxtBannerColor" Style="{StaticResource MonoTextBox}" Width="140" TextChanged="BannerColor_TextChanged"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="ACCENT COLOR"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="AccentColorPreview" Width="28" Height="28" Background="#106EBE"
                                        BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Margin="0,0,8,0"
                                        Cursor="Hand" MouseLeftButtonUp="AccentColorPicker_Click"/>
                                <TextBox x:Name="TxtAccentColor" Style="{StaticResource MonoTextBox}" Width="140" TextChanged="AccentColor_TextChanged"/>
                            </StackPanel>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="PROGRESS &amp; PACING"/>
                            <CheckBox x:Name="ChkShowProgressBar" Style="{StaticResource FeatureToggle}" Content="Show progress bar during install"/>
                            <CheckBox x:Name="ChkSimulateDelay"   Style="{StaticResource FeatureToggle}" Content="Simulate install delay"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="DELAY PER STEP (SECONDS)"/>
                            <TextBox x:Name="TxtDelaySec" Style="{StaticResource MonoTextBox}" Width="120" HorizontalAlignment="Left" Text="0.5"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Frame 06 — Package & generate ===== -->
                    <Border x:Name="FramePackage" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FrameEyebrow}" Text="FRAME 06 · PACKAGE &amp; GENERATE"/>
                            <TextBlock Style="{StaticResource FrameHeading}" Text="Package &amp; generate"/>
                            <TextBlock Style="{StaticResource FrameKicker}" Text="What TestPackage produces when you press Generate."/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLER EXE NAME"/>
                            <TextBox x:Name="TxtInstallerExeName" Style="{StaticResource MonoTextBox}"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="INSTALLED EXE NAME"/>
                            <TextBox x:Name="TxtAppExeName" Style="{StaticResource MonoTextBox}"/>
                            <TextBlock Style="{StaticResource MutedText}" Text="Name of the audit viewer the installer drops on the target machine. Rename to match your test scenario." TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="OUTPUT FOLDER"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtOutputFolder" Style="{StaticResource MonoTextBox}" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
                            </Grid>

                            <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="Silent install (/S) and command-line overrides are built in — see README for switches."/>

                            <Border Style="{StaticResource LightRule}"/>

                            <TextBlock Style="{StaticResource SectionLabel}" Text="CODE SIGNING"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Sign the generated installer .exe with your own certificate. Leave 'None' to ship unsigned (Windows will show a SmartScreen 'unknown publisher' warning to end-users)."/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="MODE"/>
                            <ComboBox x:Name="CboCodeSigningMode" Style="{StaticResource ModernComboBox}" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="CodeSigningMode_Changed">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="PFX"/>
                            </ComboBox>

                            <StackPanel x:Name="PnlSigningPfxDetails" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PFX FILE"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtCodeSigningPfxPath" Style="{StaticResource MonoTextBox}"/>
                                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowsePfx_Click"/>
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="PFX PASSWORD"/>
                                <PasswordBox x:Name="PwbCodeSigningPassword" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                             Padding="8,6" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Background="White"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="Note: the password is written to config.ini in plaintext when you Save Config. Fine for local test scenarios; not fine for anything a third party sees."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="TIMESTAMP URL"/>
                                <TextBox x:Name="TxtCodeSigningTimestamp" Style="{StaticResource MonoTextBox}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                           Text="RFC 3161 timestamp server. Default is DigiCert's free timestamp URL — override if your cert vendor requires something specific."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Receipt rail -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="2,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BrandKicker}" Text="LIVE MANIFEST"/>
                        <TextBlock Style="{StaticResource FrameHeading}" Text="Receipt" Margin="0,4,0,4"/>
                        <TextBlock Style="{StaticResource MutedText}" Text="Footprint on the test machine — updates as you edit." TextWrapping="Wrap"/>

                        <Border Style="{StaticResource HeavyRule}"/>

                        <TextBlock Style="{StaticResource BrandKicker}" Text="BEHAVIORS ENABLED"/>
                        <TextBlock x:Name="LblReceiptBehaviors" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <Border Style="{StaticResource LightRule}"/>

                        <TextBlock Style="{StaticResource BrandKicker}" Text="INSTALLER SIZE"/>
                        <TextBlock x:Name="LblReceiptSize" Style="{StaticResource MonoText}" Margin="0,4,0,0"/>

                        <Border Style="{StaticResource LightRule}"/>

                        <TextBlock Style="{StaticResource BrandKicker}" Text="ELEVATION"/>
                        <TextBlock x:Name="LblReceiptElevation" Style="{StaticResource MonoText}" Margin="0,4,0,0"/>

                        <Border Style="{StaticResource LightRule}"/>

                        <TextBlock Style="{StaticResource BrandKicker}" Text="INSTALL DIRECTORY"/>
                        <TextBlock x:Name="LblReceiptInstallDir" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                        <Border Style="{StaticResource HeavyRule}"/>

                        <TextBlock Style="{StaticResource BrandKicker}" Text="WHEN GENERATED"/>
                        <TextBlock x:Name="LblReceiptSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= Footer ================= -->
        <Border Grid.Row="5" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,2,0,0">
            <Grid Margin="24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                    TestPackage · a design tool by RWK Systems ·
                    <Hyperlink NavigateUri="https://rwksystems.com" RequestNavigate="Hyperlink_Navigate" Foreground="{StaticResource AccentDeepBrush}">rwksystems.com</Hyperlink>
                </TextBlock>
                <Button Grid.Column="1" Content="Generate installer" Style="{StaticResource PrimaryButton}" Click="GenerateInstaller_Click"/>
            </Grid>
        </Border>

        <!-- ================= Composite editor overlay ================= -->
        <!-- Master list + detail form, right-anchored. Opened by Edit data on
             any of the seven composite behaviors in Frame 03. -->
        <Grid x:Name="CompositeOverlay" Grid.RowSpan="6" Visibility="Collapsed" Panel.ZIndex="100">
            <Rectangle Fill="#59201E1D" MouseLeftButtonDown="CompositeOverlay_ScrimClick"/>
            <Border Width="860" HorizontalAlignment="Right"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource InkBrush}" BorderThickness="2,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Overlay header -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,2">
                        <Grid Margin="24,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BrandKicker}" Text="EDITING DATA"/>
                                <TextBlock x:Name="LblOverlayTitle" Style="{StaticResource FrameHeading}" Text="—" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LblOverlaySubtitle" Style="{StaticResource MutedText}" Text="" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close ✕" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Click="CompositeOverlay_Close"/>
                        </Grid>
                    </Border>

                    <!-- Overlay body: master list + detail form -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Master list -->
                        <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="OverlayMasterList" Margin="0,4,0,4"/>
                            </ScrollViewer>
                            <Border Grid.Row="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,2,0,0" Padding="16,12">
                                <Button Content="+ Add entry" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="CompositeOverlay_Add"/>
                            </Border>
                        </Grid>

                        <!-- Detail form -->
                        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource InkBrush}" BorderThickness="2,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BrandKicker}" Text="ENTRY DETAILS"/>
                                    <StackPanel x:Name="OverlayDetailForm" Margin="0,8,0,0"/>
                                    <Border Style="{StaticResource LightRule}" Margin="0,16,0,12"/>
                                    <Button x:Name="BtnOverlayRemove" Content="Remove entry" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Foreground="{StaticResource AccentDeepBrush}" Click="CompositeOverlay_Remove"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
