<Window x:Class="TestPackage.Configurator.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview — Generated Installer" Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#F2F3F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0078D4" Padding="15,10">
            <TextBlock Text="Installer Preview" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="15">
            <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas" FontSize="12" Background="White"
                     Foreground="#333" Padding="12" BorderBrush="#E0E0E0"
                     BorderThickness="1" VerticalScrollBarVisibility="Auto"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,8">
            <Button Content="Close" HorizontalAlignment="Right" Padding="16,5"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
